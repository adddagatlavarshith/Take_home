# ---- Application ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
WORKER_MODE=false

# ---- Database ----
DATABASE_URL=postgresql://amrutam:amrutam@postgres:5432/amrutam?schema=public
POSTGRES_USER=amrutam
POSTGRES_PASSWORD=amrutam
POSTGRES_DB=amrutam

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-in-production-at-least-32-chars-long-xxxxx
JWT_REFRESH_SECRET=change-me-in-production-different-value-32-chars-xxxxx
JWT_ACCESS_TTL=900           # seconds (15 min)
JWT_REFRESH_TTL=604800       # seconds (7 days)
MFA_ISSUER=Amrutam
PASSWORD_RESET_TTL=1800

# ---- Encryption key (pgcrypto PGP_SYM) ----
# Must be set; must not be committed. 32+ chars.
PII_ENCRYPTION_KEY=change-me-32-char-min-pii-key-xxxxxxxxxxxxxxxx

# ---- Payments (mock) ----
PAYMENT_WEBHOOK_SECRET=mock-webhook-secret-change-me
PAYMENT_MOCK_AUTO_CAPTURE=true

# ---- Rate limit ----
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
AUTH_RATE_LIMIT_LIMIT=10

# ---- Booking ----
BOOKING_HOLD_TTL_SECONDS=600       # 10 min
BOOKING_PAYMENT_TTL_SECONDS=900    # 15 min

# ---- Observability ----
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_SERVICE_NAME=amrutam-api

# ---- Admin bootstrap ----
ADMIN_BOOTSTRAP_EMAIL=admin@amrutam.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe-Admin1!
